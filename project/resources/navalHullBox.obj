# Box hull with reversed winding for the engine's OBJ Z-flip + back-face culling.
mtllib navalHullBox.mtl
o NavalHullBox
v 1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 -1.000000
v 1.000000 1.000000 -1.000000
v -1.000000 1.000000 -1.000000
v 1.000000 -1.000000 1.000000
v -1.000000 -1.000000 1.000000
v 1.000000 1.000000 1.000000
v -1.000000 1.000000 1.000000
vn -0.0000 -0.0000 -1.0000
vn -0.0000 -0.0000 1.0000
vn -1.0000 -0.0000 -0.0000
vn 1.0000 -0.0000 -0.0000
vn -0.0000 -1.0000 -0.0000
vn -0.0000 1.0000 -0.0000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 0.000000 1.000000
vt 1.000000 1.000000
s 1
usemtl NavalHull
f 3/3/1 2/2/1 1/1/1
f 3/3/1 4/4/1 2/2/1
f 8/3/2 5/2/2 6/1/2
f 8/3/2 7/4/2 5/2/2
f 7/3/3 1/2/3 5/1/3
f 7/3/3 3/4/3 1/2/3
f 4/3/4 6/2/4 2/1/4
f 4/3/4 8/4/4 6/2/4
f 6/3/5 1/2/5 2/1/5
f 6/3/5 5/4/5 1/2/5
f 7/3/6 4/2/6 3/1/6
f 7/3/6 8/4/6 4/2/6
